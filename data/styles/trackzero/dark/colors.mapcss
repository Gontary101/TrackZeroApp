/* TrackZero map palette (design.html "Tokens · Map style"), applied on top of default/dark/colors.mapcss.
   OLED black ground, near-invisible landuse, two road greys, muted cycleways, one label grey.
   Only colours change here; geometry, widths and visibility come from the base styles. */

/* Basemap / boundaries */
@background0: #000000;
@background1: #000000;
@border_country: #2A2D32;
@border_region: #202225;

/* Natural */
@glacier: #141517;
@water: #0A1620;
@water_bad: #0A1620;
@wetland_tidal: #0A1418;
@wetland_tidal_saltmarsh: #0A1418;
@wetland_saltmarsh: #0A1418;
@wetland_marsh: #0A1418;
@wetland_fen: #0A1418;
@wetland_bog: #0A1418;
@wetland_reedbed: #0A1418;
@wetland_swamp: #0A1418;
@wetland_mangrove: #0A1418;
@beach: #0B0C0D;
@sand: #0B0C0D;
@barerock: #0B0C0D;
@scree: #0B0C0D;
@desert: #0B0C0D;

/* Vegetation: one park/forest tone */
@residential_garden: #000000;
@residential_garden_13: #000000;
@residential_garden_12: #000000;
@park: #06100A;
@park_13: #06100A;
@park_12: #06100A;
@park_11: #06100A;
@park_10: #06100A;
@heath: #06100A;
@heath_13: #06100A;
@heath_12: #06100A;
@heath_11: #06100A;
@grass: #06100A;
@grass_13: #06100A;
@grass_12: #06100A;
@grass_11: #06100A;
@flowers: #06100A;
@flowers_13: #06100A;
@flowers_12: #06100A;
@flowers_11: #06100A;
@flowers_10: #06100A;
@golf: #06100A;
@golf_13: #06100A;
@golf_12: #06100A;
@allotments: #06100A;
@allotments_13: #06100A;
@allotments_12: #06100A;
@scrubs: #06100A;
@scrubs_13: #06100A;
@scrubs_12: #06100A;
@scrubs_11: #06100A;
@woods: #06100A;
@woods_13: #06100A;
@woods_12: #06100A;
@woods_11: #06100A;
@woods_10: #06100A;
@protected_nature: #050C08;

/* Landuse: almost black */
@general_area: #050606;
@pedestrian_area: #111214;
@railway_platform: #111214;
@university: #050606;
@hospital: #050606;
@industrial: #070808;
@construction_area: #070808;
@sport0: #08100B;
@sport1: #08100B;
@sport2: #08100B;
@playground: #08100B;
@parking: #0B0C0D;
@military: #2D1316;
@prison: #202225;
@farmland: #050605;
@farmyard: #050605;
@aerodrome0: #0B0C0D;
@aerodrome1: #0B0C0D;
@aerodrome2: #0B0C0D;
@aerodrome3: #0B0C0D;
@aerodrome4: #0B0C0D;
@aerodrome5: #0B0C0D;
@fence: #17191C;
@hedge: #06100A;
@cliff: #202225;
@building0: #0E0F11;
@building1: #0E0F11;
@building_border0: #141517;
@building_border1: #141517;
@historic_wall: #17191C;

/* Roads: major #2A2D32, minor #17191C, cycleways #4A6355 */
