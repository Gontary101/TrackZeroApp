/* TrackZero map palette, Light (Phase 36, design.html "Tokens v2 · Map style · Light"), applied on top of
   default/light/colors.mapcss. A pale warm ground, white roads with grey casings, a strong green cycleway, soft water
   and parks, one label grey. Only colours change here; geometry, widths and visibility come from the base styles.
   Minor-road casings: the base draws them at 10 % opacity, so black (the base value) gives about #DCDCD7 on the
   ground, the nearest the include allows to the token's #D5D8D2. */

/* Basemap / boundaries */
@background0: #F4F4EF;
@background1: #F4F4EF;
@border_country: #9BA0A6;
@border_region: #B9BDB6;

/* Natural */
@glacier: #FFFFFF;
@water: #B9D6F2;
@water_bad: #B9D6F2;
@wetland_tidal: #DCE6EC;
@wetland_tidal_saltmarsh: #DCE6EC;
@wetland_saltmarsh: #DCE6EC;
@wetland_marsh: #DCE6EC;
@wetland_fen: #DCE6EC;
@wetland_bog: #DCE6EC;
@wetland_reedbed: #DCE6EC;
@wetland_swamp: #DCE6EC;
@wetland_mangrove: #DCE6EC;
@beach: #ECEDE6;
@sand: #ECEDE6;
@barerock: #ECEDE6;
@scree: #ECEDE6;
@desert: #ECEDE6;

