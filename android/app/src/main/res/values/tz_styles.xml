<?xml version="1.0" encoding="utf-8"?>
<!-- Component styles built on the plan's TzText styles (tz_type.xml). -->
<resources>
  <style name="TzText.IslandLabel.Ride">
    <item name="android:fontFamily">@font/barlow_bold</item>
    <item name="android:letterSpacing">0.13</item>
    <item name="android:textColor">@color/tz_on_mint</item>
  </style>

  <!-- GPS / REC chip text: Barlow Condensed SemiBold 17sp, tracking 1px -->
  <style name="TzText.Chip">
    <item name="android:fontFamily">@font/barlow_condensed_semibold</item>
    <item name="android:textSize">@dimen/tz_text_17</item>
    <item name="android:letterSpacing">0.06</item>
  </style>

  <!-- Turn card -->
  <style name="TzText.TurnInstruction">
    <item name="android:fontFamily">@font/barlow_bold</item>
    <item name="android:textSize">@dimen/tz_text_18</item>
  </style>
  <style name="TzText.TurnExit">
    <item name="android:fontFamily">@font/barlow_condensed_bold</item>
    <item name="android:textSize">@dimen/tz_text_16</item>
    <item name="android:textColor">@color/tz_text1</item>
  </style>
  <style name="TzText.TurnStreet">
    <item name="android:fontFamily">@font/barlow_medium</item>
    <item name="android:textSize">@dimen/tz_text_16</item>
    <item name="android:textColor">@color/tz_text2</item>
  </style>
  <style name="TzText.TurnThen">
    <item name="android:fontFamily">@font/barlow_semibold</item>
    <item name="android:textSize">@dimen/tz_text_15</item>
    <item name="android:textColor">@color/tz_text2</item>
  </style>
  <style name="TzText.OffRouteTitle" parent="TzText.DotM">
    <item name="android:textColor">@color/tz_amber</item>
    <item name="android:letterSpacing">0.05</item>
  </style>
  <style name="TzText.OffRouteLine">
    <item name="android:fontFamily">@font/barlow_semibold</item>
    <item name="android:textSize">@dimen/tz_text_16</item>
    <item name="android:textColor">@color/tz_amber_text2</item>
  </style>

  <!-- Buttons (Components board): 64dp, radius 20, type.button, icon 22dp + 10dp gap centred with the text -->
  <style name="TzButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
    <item name="android:minHeight">@dimen/tz_button_h</item>
    <item name="android:insetTop">0dp</item>
    <item name="android:insetBottom">0dp</item>
    <item name="android:fontFamily">@font/barlow_condensed_bold</item>
    <item name="android:textSize">@dimen/tz_text_22</item>
    <item name="android:letterSpacing">0.09</item>
    <item name="android:textAllCaps">true</item>
    <item name="android:includeFontPadding">false</item>
    <item name="android:stateListAnimator">@animator/tz_press</item>
    <item name="cornerRadius">@dimen/tz_radius_button</item>
    <item name="iconGravity">textStart</item>
    <item name="iconSize">@dimen/tz_button_icon</item>
    <item name="iconPadding">@dimen/tz_button_icon_gap</item>
    <item name="rippleColor">@android:color/transparent</item>
    <item name="elevation">0dp</item>
  </style>
  <style name="TzButton.Primary">
    <item name="backgroundTint">@color/tz_button_primary_bg</item>
    <item name="android:textColor">@color/tz_button_primary_ink</item>
    <item name="iconTint">@color/tz_button_primary_ink</item>
  </style>
  <style name="TzButton.Secondary">
    <item name="backgroundTint">@color/tz_surface3</item>
    <item name="android:textColor">@color/tz_text1</item>
    <item name="iconTint">@color/tz_text1</item>
  </style>
  <style name="TzButton.Danger">
    <item name="backgroundTint">@color/tz_danger_bg</item>
    <item name="android:textColor">@color/tz_danger</item>
    <item name="iconTint">@color/tz_danger</item>
  </style>
  <style name="TzButton.Primary.Resume">
    <item name="android:minHeight">@dimen/tz_button_resume_h</item>
  </style>

  <!-- ProfilePill label: 13sp Bold, 1.6dp tracking, caps -->
  <style name="TzText.ProfilePill">
    <item name="android:fontFamily">@font/barlow_bold</item>
    <item name="android:textSize">@dimen/tz_text_13</item>
    <item name="android:letterSpacing">0.123</item>
    <item name="android:textAllCaps">true</item>
  </style>

  <!-- Modal sheets (ProfileSheet): the sheet draws its own surface1 background with 32dp top corners -->
  <style name="ThemeOverlay.TrackZero.BottomSheet" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
    <item name="bottomSheetStyle">@style/TzBottomSheet</item>
    <item name="android:navigationBarColor">@color/tz_surface1</item>
    <item name="elevationOverlayEnabled">false</item>
  </style>
  <style name="TzBottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
    <item name="android:background">@android:color/transparent</item>
    <item name="backgroundTint">@android:color/transparent</item>
  </style>

  <!-- Toggle / list rows -->
  <style name="TzText.RowTitle">
    <item name="android:fontFamily">@font/barlow_semibold</item>
    <item name="android:textSize">@dimen/tz_text_17</item>
  </style>
  <style name="TzText.RowSubtitle">
    <item name="android:fontFamily">@font/barlow_medium</item>
    <item name="android:textSize">@dimen/tz_text_13</item>
    <item name="android:textColor">@color/tz_text2</item>
  </style>
  <style name="TzText.RowDetail">
    <item name="android:fontFamily">@font/barlow_medium</item>
    <item name="android:textSize">@dimen/tz_text_15</item>
    <item name="android:textColor">@color/tz_text2</item>
  </style>
  <!-- Segmented options and category chips: 15sp SemiBold -->
  <style name="TzText.Option">
    <item name="android:fontFamily">@font/barlow_semibold</item>
    <item name="android:textSize">@dimen/tz_text_15</item>
  </style>

  <style name="TzText.Attribution">
    <item name="android:fontFamily">@font/barlow_medium</item>
    <item name="android:textSize">@dimen/tz_text_10</item>
    <item name="android:textColor">@color/tz_attribution</item>
  </style>

  <style name="TzText.Footer" parent="TzText.Caption">
    <item name="android:lineSpacingMultiplier">1.5</item>
  </style>

  <!-- A card of TzListRows with inset dividers (B7). -->
  <style name="TzListGroup">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:orientation">vertical</item>
    <item name="android:background">@drawable/tz_bg_surface1_r24</item>
    <item name="android:divider">@drawable/tz_list_divider</item>
    <item name="android:showDividers">middle</item>
  </style>
  <style name="TzListRow">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
  </style>

  <!-- B3 header IMPORT: 48dp surface3 pill, mint icon, Barlow Bold 15sp -->
  <style name="TzButton.Import" parent="TzButton">
    <item name="android:minHeight">@dimen/tz_import_btn_h</item>
    <item name="android:paddingStart">@dimen/tz_import_pad_start</item>
    <item name="android:paddingEnd">@dimen/tz_import_pad_end</item>
    <item name="android:fontFamily">@font/barlow_bold</item>
    <item name="android:textSize">@dimen/tz_text_15</item>
    <item name="android:letterSpacing">0.07</item>
    <item name="cornerRadius">@dimen/tz_radius_card</item>
    <item name="iconSize">@dimen/tz_import_icon</item>
    <item name="iconPadding">@dimen/tz_space_8</item>
    <item name="backgroundTint">@color/tz_surface3</item>
    <item name="android:textColor">@color/tz_text1</item>
    <item name="iconTint">@color/tz_mint</item>
  </style>
  <!-- B4 IMPORT GPX: primary, 60dp -->
  <style name="TzButton.Primary.Empty">
    <item name="android:minHeight">@dimen/tz_empty_cta_h</item>
    <item name="android:paddingStart">@dimen/tz_empty_cta_pad</item>
    <item name="android:paddingEnd">@dimen/tz_empty_cta_pad</item>
  </style>
  <style name="TzText.EmptyTitle">
    <item name="android:fontFamily">@font/barlow_bold</item>
    <item name="android:textSize">@dimen/tz_text_24</item>
  </style>

  <style name="TzText.PreviewTitle">
    <item name="android:fontFamily">@font/barlow_bold</item>
    <item name="android:textSize">@dimen/tz_text_26</item>
    <item name="android:lineSpacingMultiplier">1.1</item>
  </style>
  <style name="TzText.PeekTitle">
    <item name="android:fontFamily">@font/barlow_bold</item>
    <item name="android:textSize">@dimen/tz_text_17</item>
  </style>
  <style name="TzText.PeekStats">
    <item name="android:fontFamily">@font/barlow_condensed_semibold</item>
    <item name="android:textSize">@dimen/tz_text_18</item>
    <item name="android:textColor">@color/tz_text2</item>
  </style>
  <!-- 56dp floating map button (B5 back / star, R1 locate) -->
  <style name="TzMapButton">
    <item name="android:layout_width">@dimen/tz_map_btn</item>
    <item name="android:layout_height">@dimen/tz_map_btn</item>
    <item name="android:background">@drawable/tz_bg_surface2_r18</item>
    <item name="android:elevation">@dimen/tz_elev2</item>
    <item name="tint">@color/tz_text1</item>
  </style>

  <!-- Ride controls sheet header: "1:42:18 · 38.2 km" -->
  <!-- R5 header: climb name in Doto 26sp (1px tracking), CLIMB 1/3 pill in mint Barlow Bold 12sp (2px) -->
  <style name="TzText.ClimbTitle" parent="TzText.DotM">
    <item name="android:textSize">@dimen/tz_text_26</item>
    <item name="android:letterSpacing">0.04</item>
  </style>
  <style name="TzText.ClimbPill">
    <item name="android:fontFamily">@font/barlow_bold</item>
    <item name="android:textSize">12sp</item>
    <item name="android:letterSpacing">0.17</item>
    <item name="android:textColor">@color/tz_mint</item>
  </style>

  <!-- B2: field 18sp SemiBold, result name 17sp SemiBold, kind 14sp Medium text2 -->
  <style name="TzText.SearchInput">
    <item name="android:fontFamily">@font/barlow_semibold</item>
    <item name="android:textSize">@dimen/tz_text_18</item>
    <item name="android:textColor">@color/tz_text1</item>
    <item name="android:textColorHint">@color/tz_text2</item>
  </style>
  <style name="TzText.ResultName">
    <item name="android:fontFamily">@font/barlow_semibold</item>
    <item name="android:textSize">@dimen/tz_text_17</item>
    <item name="android:textColor">@color/tz_text1</item>
  </style>
  <style name="TzText.ResultSubtitle">
    <item name="android:fontFamily">@font/barlow_medium</item>
    <item name="android:textSize">@dimen/tz_text_14</item>
    <item name="android:textColor">@color/tz_text2</item>
  </style>

  <style name="TzText.SheetSummary">
    <item name="android:fontFamily">@font/barlow_condensed_semibold</item>
    <item name="android:textSize">@dimen/tz_text_20</item>
    <item name="android:textColor">@color/tz_text2</item>
  </style>
</resources>
