<?xml version="1.0" encoding="utf-8"?>
<!-- A screen leaving under another opaque one: it stays drawn while the new one fades in over it, so the map under
     both never shows through the crossfade (D66). -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
  android:duration="@integer/tz_crossfade_ms"
  android:propertyName="alpha"
  android:valueFrom="1"
  android:valueTo="1"
  android:valueType="floatType" />
