<?xml version="1.0" encoding="utf-8"?>
<!-- One S1 place (Phase 30): the search row's look (44dp icon tile, name, kind and where, distance ahead), with a
     note line when the place needs one; hairline below. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/tz_bg_row_divider"
  android:foreground="?attr/selectableItemBackground"
  android:gravity="center_vertical"
  android:minHeight="@dimen/tz_search_row_h"
  android:orientation="horizontal"
  android:paddingStart="@dimen/tz_gutter"
  android:paddingTop="@dimen/tz_space_12"
  android:paddingEnd="@dimen/tz_gutter"
  android:paddingBottom="@dimen/tz_space_12">

  <ImageView
    android:id="@+id/tz_stop_row_icon"
    android:layout_width="@dimen/tz_search_tile"
    android:layout_height="@dimen/tz_search_tile"
    android:background="@drawable/tz_bg_surface3_r14"
    android:importantForAccessibility="no"
    android:padding="@dimen/tz_search_tile_pad"
    app:tint="@color/tz_text2" />

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/tz_search_row_gap"
    android:layout_marginEnd="@dimen/tz_space_12"
    android:layout_weight="1"
    android:orientation="vertical">
    <TextView
      android:id="@+id/tz_stop_row_name"
      style="@style/TzText.ResultName"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1" />
    <TextView
      android:id="@+id/tz_stop_row_subtitle"
      style="@style/TzText.ResultSubtitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/tz_search_row_text_gap"
      android:ellipsize="end"
      android:maxLines="1" />
    <TextView
      android:id="@+id/tz_stop_row_note"
      style="@style/TzText.ResultSubtitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/tz_search_row_text_gap"
      android:visibility="gone" />
  </LinearLayout>

  <app.trackzero.ui.TzMetricView
    android:id="@+id/tz_stop_row_distance"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:tzNumberSize="22"
    app:tzNumberStyle="@style/TzText.MetricS" />
</LinearLayout>
