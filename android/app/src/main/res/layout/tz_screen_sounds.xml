<?xml version="1.0" encoding="utf-8"?>
<!-- M1 · Sounds (Phase 32): tones, spoken directions, the two warnings, and the tones to hear. Opaque, island. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:id="@+id/tz_sounds_scroll"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/tz_bg"
  android:clipToPadding="false">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/tz_gutter"
    android:paddingEnd="@dimen/tz_gutter">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageButton
        android:id="@+id/tz_sounds_back"
        android:layout_width="@dimen/tz_touch_min_browse"
        android:layout_height="@dimen/tz_touch_min_browse"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/tz_cd_back_to_more"
        android:src="@drawable/ic_tz_back"
        app:tint="@color/tz_text1" />
      <TextView
        style="@style/TzText.DotXL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/tz_space_12"
        android:text="@string/tz_sounds_title" />
    </LinearLayout>

    <LinearLayout style="@style/TzListGroup" android:layout_marginTop="@dimen/tz_space_20">
      <app.trackzero.ui.TzToggleRow
        android:id="@+id/tz_sounds_tones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tzIcon="@drawable/ic_tz_bell"
        app:tzTitle="@string/tz_tones_title" />
      <app.trackzero.ui.TzToggleRow
        android:id="@+id/tz_sounds_voice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tzIcon="@drawable/ic_tz_voice"
        app:tzTitle="@string/tz_sounds_spoken" />
    </LinearLayout>

    <LinearLayout style="@style/TzListGroup" android:layout_marginTop="@dimen/tz_space_12">
      <app.trackzero.ui.TzToggleRow
        android:id="@+id/tz_sounds_off_route"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tzIcon="@drawable/ic_tz_reroute"
        app:tzTitle="@string/tz_sounds_off_route" />
      <app.trackzero.ui.TzToggleRow
        android:id="@+id/tz_sounds_gps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tzIcon="@drawable/ic_tz_gps_off"
        app:tzTitle="@string/tz_sounds_gps" />
    </LinearLayout>

    <TextView
      style="@style/TzText.Label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tz_space_4"
      android:layout_marginTop="@dimen/tz_space_24"
      android:text="@string/tz_sounds_tap" />

    <include
      layout="@layout/tz_tone_grid"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/tz_space_12" />

    <TextView
      style="@style/TzText.Caption"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tz_space_4"
      android:layout_marginTop="@dimen/tz_space_20"
      android:text="@string/tz_sounds_caption" />
  </LinearLayout>
</ScrollView>
