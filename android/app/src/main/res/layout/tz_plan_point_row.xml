<?xml version="1.0" encoding="utf-8"?>
<!-- PlanPoint row (Components v2): drag handle, number or flag, name, remove. 48 high. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="@dimen/tz_plan_row_h"
  android:gravity="center_vertical"
  android:orientation="horizontal">
  <ImageView
    android:id="@+id/tz_plan_row_drag"
    android:layout_width="@dimen/tz_profile_pill_icon"
    android:layout_height="@dimen/tz_profile_pill_icon"
    android:contentDescription="@string/tz_plan_cd_reorder"
    android:src="@drawable/ic_tz_drag"
    app:tint="@color/tz_text3" />
  <FrameLayout
    android:layout_width="@dimen/tz_choice"
    android:layout_height="@dimen/tz_choice"
    android:layout_marginStart="@dimen/tz_space_12"
    android:background="@drawable/tz_bg_surface3_circle">
    <TextView
      android:id="@+id/tz_plan_row_number"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:fontFamily="@font/barlow_condensed_bold"
      android:gravity="center"
      android:textColor="@color/tz_text1"
      android:textSize="@dimen/tz_text_14" />
    <ImageView
      android:id="@+id/tz_plan_row_flag"
      android:layout_width="@dimen/tz_choice_check"
      android:layout_height="@dimen/tz_choice_check"
      android:layout_gravity="center"
      android:importantForAccessibility="no"
      android:src="@drawable/ic_tz_flag"
      android:visibility="gone"
      app:tint="@color/tz_text1" />
  </FrameLayout>
  <TextView
    android:id="@+id/tz_plan_row_name"
    style="@style/TzText.RowTitle"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/tz_row_gap"
    android:layout_weight="1"
    android:ellipsize="end"
    android:maxLines="1" />
  <ImageButton
    android:id="@+id/tz_plan_row_remove"
    android:layout_width="@dimen/tz_plan_row_h"
    android:layout_height="@dimen/tz_plan_row_h"
    android:background="@null"
    android:contentDescription="@string/tz_plan_cd_remove"
    android:src="@drawable/ic_tz_close"
    app:tint="@color/tz_text2" />
</LinearLayout>
