<?xml version="1.0" encoding="utf-8"?>
<!-- One tutorial step: the visual, the Doto title, one sentence (centred in the space between header and button). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:gravity="center"
  android:orientation="vertical">
  <FrameLayout
    android:id="@+id/tz_tut_visual"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" />
  <TextView
    android:id="@+id/tz_tut_title"
    style="@style/TzText.DotTut"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/tz_tut_gap"
    android:accessibilityHeading="true"
    android:gravity="center" />
  <TextView
    android:id="@+id/tz_tut_text"
    style="@style/TzText.TutBody"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/tz_tut_text_gap"
    android:breakStrategy="balanced"
    android:gravity="center"
    android:maxWidth="@dimen/tz_tut_text_max" />
</LinearLayout>
