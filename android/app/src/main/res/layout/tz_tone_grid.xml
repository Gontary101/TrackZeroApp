<?xml version="1.0" encoding="utf-8"?>
<!-- The six ToneTiles (M1's "Tap to hear", T3), 10dp apart (Components v2). Bound by ToneGrid. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:orientation="vertical">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="@dimen/tz_tone_tile_h"
    android:orientation="horizontal">
    <app.trackzero.ui.TzToneTile android:id="@+id/tz_tone_left" android:layout_width="0dp"
      android:layout_height="match_parent" android:layout_weight="1" />
    <app.trackzero.ui.TzToneTile android:id="@+id/tz_tone_straight" android:layout_width="0dp"
      android:layout_height="match_parent" android:layout_marginStart="@dimen/tz_tone_tile_gap"
      android:layout_weight="1" />
    <app.trackzero.ui.TzToneTile android:id="@+id/tz_tone_right" android:layout_width="0dp"
      android:layout_height="match_parent" android:layout_marginStart="@dimen/tz_tone_tile_gap"
      android:layout_weight="1" />
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="@dimen/tz_tone_tile_h"
    android:layout_marginTop="@dimen/tz_tone_tile_gap"
    android:orientation="horizontal">
    <app.trackzero.ui.TzToneTile android:id="@+id/tz_tone_arrived" android:layout_width="0dp"
      android:layout_height="match_parent" android:layout_weight="1" />
    <app.trackzero.ui.TzToneTile android:id="@+id/tz_tone_off_route" android:layout_width="0dp"
      android:layout_height="match_parent" android:layout_marginStart="@dimen/tz_tone_tile_gap"
      android:layout_weight="1" />
    <app.trackzero.ui.TzToneTile android:id="@+id/tz_tone_gps" android:layout_width="0dp"
      android:layout_height="match_parent" android:layout_marginStart="@dimen/tz_tone_tile_gap"
      android:layout_weight="1" />
  </LinearLayout>
</LinearLayout>
