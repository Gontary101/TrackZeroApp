<?xml version="1.0" encoding="utf-8"?>
<!-- P1 · Plan a route / P2 · planning (Phase 28): pins over the map, the profile, undo, the plan's card. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <app.trackzero.ui.TzPinLayer
    android:id="@+id/tz_plan_pins"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />

  <LinearLayout
    android:id="@+id/tz_plan_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="top"
    android:layout_marginStart="@dimen/tz_gutter"
    android:layout_marginEnd="@dimen/tz_gutter"
    android:orientation="horizontal">
    <ImageButton
      android:id="@+id/tz_plan_back"
      style="@style/TzMapButton"
      android:contentDescription="@string/tz_cd_back"
      android:src="@drawable/ic_tz_back" />
    <FrameLayout
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1">
      <app.trackzero.ui.TzProfilePill
        android:id="@+id/tz_plan_profile_pill"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/tz_profile_pill_h"
        android:layout_gravity="top|center_horizontal" />
    </FrameLayout>
    <ImageButton
      android:id="@+id/tz_plan_undo"
      style="@style/TzMapButton"
      android:contentDescription="@string/tz_plan_undo"
      android:src="@drawable/ic_tz_undo" />
  </LinearLayout>

  <FrameLayout
    android:id="@+id/tz_plan_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginStart="@dimen/tz_gutter_ride"
    android:layout_marginEnd="@dimen/tz_gutter_ride"
    android:background="@drawable/tz_bg_surface2_r32"
    android:clickable="true"
    android:elevation="@dimen/tz_elev2">

    <!-- P1: nothing placed yet. -->
    <LinearLayout
      android:id="@+id/tz_plan_empty"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="@dimen/tz_preview_card_pad">
      <TextView
        style="@style/TzText.DotL"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tz_plan_title" />
      <TextView
        android:id="@+id/tz_plan_empty_hint"
        style="@style/TzText.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tz_space_8"
        android:text="@string/tz_plan_empty_hint" />
      <LinearLayout
        android:id="@+id/tz_plan_start_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tz_space_16"
        android:background="@drawable/tz_bg_surface3_r20"
        android:gravity="center_vertical"
        android:minHeight="@dimen/tz_plan_row_h"
        android:orientation="horizontal"
        android:paddingStart="@dimen/tz_space_16"
        android:paddingEnd="@dimen/tz_space_16">
        <ImageView
          android:layout_width="@dimen/tz_icon"
          android:layout_height="@dimen/tz_icon"
          android:importantForAccessibility="no"
          android:src="@drawable/ic_tz_locate"
          app:tint="@color/tz_text2" />
        <TextView
          android:id="@+id/tz_plan_start_text"
          style="@style/TzText.RowTitle"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/tz_row_gap"
          android:layout_weight="1"
          android:text="@string/tz_plan_from_here" />
        <TextView
          android:id="@+id/tz_plan_start_change"
          style="@style/TzText.Label"
          android:layout_width="wrap_content"
          android:layout_height="@dimen/tz_plan_row_h"
          android:gravity="center"
          android:paddingStart="@dimen/tz_space_8"
          android:text="@string/tz_plan_change" />
      </LinearLayout>
    </LinearLayout>

    <!-- P2: the plan. -->
    <LinearLayout
      android:id="@+id/tz_plan_full"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="@dimen/tz_preview_card_pad"
      android:paddingTop="@dimen/tz_space_12"
      android:paddingEnd="@dimen/tz_preview_card_pad"
      android:paddingBottom="@dimen/tz_preview_card_pad"
      android:visibility="gone">
      <View
        android:layout_width="@dimen/tz_grabber_w"
        android:layout_height="@dimen/tz_grabber_h"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/tz_bg_grabber_r2" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tz_space_16"
        android:orientation="horizontal">
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">
          <TextView
            style="@style/TzText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tz_preview_distance" />
          <app.trackzero.ui.TzMetricView
            android:id="@+id/tz_plan_stat0"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tz_label_gap"
            app:tzNumberSize="36"
            app:tzNumberStyle="@style/TzText.MetricM" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">
          <TextView
            style="@style/TzText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tz_preview_gain" />
          <app.trackzero.ui.TzMetricView
            android:id="@+id/tz_plan_stat1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tz_label_gap"
            app:tzNumberSize="36"
            app:tzNumberStyle="@style/TzText.MetricM" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">
          <TextView
            style="@style/TzText.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tz_plan_time" />
          <app.trackzero.ui.TzMetricView
            android:id="@+id/tz_plan_stat2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/tz_label_gap"
            app:tzNumberSize="36"
            app:tzNumberStyle="@style/TzText.MetricM" />
        </LinearLayout>
      </LinearLayout>
      <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/tz_divider"
        android:layout_marginTop="@dimen/tz_space_12"
        android:background="@color/tz_divider" />
      <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tz_plan_points"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never" />
      <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/tz_divider"
        android:background="@color/tz_divider" />
      <TextView
        android:id="@+id/tz_plan_hint"
        style="@style/TzText.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tz_space_12"
        android:text="@string/tz_plan_hint" />
      <com.google.android.material.button.MaterialButton
        android:id="@+id/tz_plan_preview"
        style="@style/TzButton.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/tz_space_16"
        android:text="@string/tz_plan_preview" />
    </LinearLayout>
  </FrameLayout>
</FrameLayout>
