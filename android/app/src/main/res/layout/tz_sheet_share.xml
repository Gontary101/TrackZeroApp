<?xml version="1.0" encoding="utf-8"?>
<!-- E1 · Share location (Phase 34): two wordings, the editable message, the fix and battery line, COPY and SHARE. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/tz_bg_surface1_top_r32"
  android:orientation="vertical"
  android:paddingStart="@dimen/tz_gutter"
  android:paddingTop="@dimen/tz_sheet_pad_top"
  android:paddingEnd="@dimen/tz_gutter"
  android:paddingBottom="@dimen/tz_space_24">

  <View
    android:layout_width="@dimen/tz_sheet_grabber_w"
    android:layout_height="@dimen/tz_sheet_grabber_h"
    android:layout_gravity="center_horizontal"
    android:background="@drawable/tz_bg_text3_r3" />

  <TextView
    style="@style/TzText.DotL"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/tz_space_20"
    android:paddingStart="@dimen/tz_sheet_header_pad"
    android:paddingEnd="@dimen/tz_sheet_header_pad"
    android:paddingBottom="@dimen/tz_sheet_header_pad_bottom"
    android:text="@string/tz_share_title" />

  <app.trackzero.ui.TzSegmented
    android:id="@+id/tz_share_wording"
    android:layout_width="match_parent"
    android:layout_height="wrap_content" />

  <EditText
    android:id="@+id/tz_share_text"
    style="@style/TzText.Body"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/tz_space_12"
    android:background="@drawable/tz_bg_surface3_r20"
    android:gravity="top|start"
    android:importantForAutofill="no"
    android:inputType="textMultiLine|textNoSuggestions"
    android:minLines="4"
    android:padding="@dimen/tz_space_16"
    android:textColor="@color/tz_text1" />

  <TextView
    android:id="@+id/tz_share_status"
    style="@style/TzText.Caption"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/tz_space_4"
    android:layout_marginTop="@dimen/tz_space_12"
    android:drawablePadding="@dimen/tz_space_8"
    android:gravity="center_vertical" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/tz_space_16"
    android:orientation="horizontal">
    <com.google.android.material.button.MaterialButton
      android:id="@+id/tz_share_copy"
      style="@style/TzButton.Secondary"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:text="@string/tz_share_copy"
      app:icon="@drawable/ic_tz_copy" />
    <com.google.android.material.button.MaterialButton
      android:id="@+id/tz_share_send"
      style="@style/TzButton.Primary"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tz_space_12"
      android:layout_weight="1"
      android:text="@string/tz_share_share"
      app:icon="@drawable/ic_tz_share" />
  </LinearLayout>

  <TextView
    style="@style/TzText.Caption"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/tz_space_12"
    android:gravity="center_horizontal"
    android:text="@string/tz_share_caption" />
</LinearLayout>
