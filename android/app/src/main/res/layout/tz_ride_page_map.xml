<?xml version="1.0" encoding="utf-8"?>
<!-- R1 / R2 page 0: transparent over the map. Clickable so the map under it ignores touches while riding. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:clickable="true"
  android:focusable="false">

  <LinearLayout
    android:id="@+id/tz_ride_map_top"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/tz_gutter"
    android:layout_marginEnd="@dimen/tz_gutter"
    android:gravity="top"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/tz_ride_pill"
      style="@style/TzText.DotM"
      android:layout_width="wrap_content"
      android:layout_height="@dimen/tz_chip_h"
      android:background="@drawable/tz_bg_surface2_r22"
      android:elevation="@dimen/tz_elev2"
      android:gravity="center_vertical"
      android:paddingStart="@dimen/tz_ride_pill_pad"
      android:paddingEnd="@dimen/tz_ride_pill_pad"
      android:text="@string/tz_free_ride"
      android:textSize="@dimen/tz_text_18" />

    <Space
      android:layout_width="0dp"
      android:layout_height="0dp"
      android:layout_weight="1" />

    <ImageButton
      android:id="@+id/tz_ride_locate"
      style="@style/TzMapButton"
      android:contentDescription="@string/tz_cd_recenter"
      android:src="@drawable/ic_tz_locate" />
  </LinearLayout>

  <app.trackzero.ui.TzTurnCard
    android:id="@+id/tz_ride_turn"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/tz_gutter_ride"
    android:layout_marginEnd="@dimen/tz_gutter_ride"
    android:visibility="gone" />

  <app.trackzero.ui.TzStatsIsland
    android:id="@+id/tz_ride_stats"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tz_stats_island_h"
    android:layout_gravity="bottom"
    android:layout_marginStart="@dimen/tz_gutter_ride"
    android:layout_marginEnd="@dimen/tz_gutter_ride" />
</FrameLayout>
