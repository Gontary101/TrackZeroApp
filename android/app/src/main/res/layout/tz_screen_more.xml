<?xml version="1.0" encoding="utf-8"?>
<!-- B7 · More. Opaque. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/tz_bg"
  android:clickable="true"
  android:fillViewport="true">
  <LinearLayout
    android:id="@+id/tz_more_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/tz_gutter"
    android:paddingEnd="@dimen/tz_gutter">
    <TextView
      style="@style/TzText.DotXL"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tz_space_4"
      android:layout_marginBottom="@dimen/tz_space_20"
      android:text="@string/tz_more_title" />
    <LinearLayout style="@style/TzListGroup">
      <app.trackzero.ui.TzListRow android:id="@+id/tz_more_offline" style="@style/TzListRow"
        app:tzIcon="@drawable/ic_tz_download" app:tzTitle="@string/tz_more_offline_maps" />
      <app.trackzero.ui.TzListRow android:id="@+id/tz_more_history" style="@style/TzListRow"
        app:tzIcon="@drawable/ic_tz_history" app:tzTitle="@string/tz_more_history" />
    </LinearLayout>
    <LinearLayout style="@style/TzListGroup" android:layout_marginTop="@dimen/tz_space_16">
      <app.trackzero.ui.TzListRow android:id="@+id/tz_more_units" style="@style/TzListRow"
        app:tzIcon="@drawable/ic_tz_ruler" app:tzTitle="@string/tz_more_units" />
      <app.trackzero.ui.TzListRow android:id="@+id/tz_more_voice" style="@style/TzListRow"
        app:tzIcon="@drawable/ic_tz_voice" app:tzTitle="@string/tz_sounds" />
      <app.trackzero.ui.TzListRow android:id="@+id/tz_more_display" style="@style/TzListRow"
        app:tzIcon="@drawable/ic_tz_sun" app:tzTitle="@string/tz_more_display" />
      <app.trackzero.ui.TzListRow android:id="@+id/tz_more_auto_pause" style="@style/TzListRow"
        app:tzIcon="@drawable/ic_tz_pause" app:tzTitle="@string/tz_more_auto_pause" />
    </LinearLayout>
    <LinearLayout style="@style/TzListGroup" android:layout_marginTop="@dimen/tz_space_16">
      <app.trackzero.ui.TzListRow android:id="@+id/tz_more_about" style="@style/TzListRow"
        app:tzIcon="@drawable/ic_tz_info" app:tzTitle="@string/tz_more_about" />
    </LinearLayout>
    <TextView
      style="@style/TzText.Footer"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tz_space_4"
      android:layout_marginTop="@dimen/tz_space_20"
      android:layout_marginEnd="@dimen/tz_space_4"
      android:text="@string/tz_more_footer" />
  </LinearLayout>
</ScrollView>
