<?xml version="1.0" encoding="utf-8"?>
<!-- T1 · SWIPE: a small phone on the speed page with the page dots; the arrows nudge left and right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/tz_tut_swipe"
  android:layout_width="wrap_content"
  android:layout_height="wrap_content"
  android:layout_gravity="center_horizontal"
  android:contentDescription="@string/tz_tut_swipe_text"
  android:focusable="true"
  android:gravity="center_vertical"
  android:orientation="horizontal">
  <ImageView
    android:id="@+id/tz_tut_arrow_left"
    android:layout_width="@dimen/tz_tut_arrow"
    android:layout_height="@dimen/tz_tut_arrow"
    android:importantForAccessibility="no"
    android:src="@drawable/ic_tz_arrow_left"
    android:tint="@color/tz_mint" />
  <FrameLayout
    android:layout_width="@dimen/tz_tut_frame_w"
    android:layout_height="@dimen/tz_tut_frame_h"
    android:layout_marginStart="@dimen/tz_tut_arrow_gap"
    android:layout_marginEnd="@dimen/tz_tut_arrow_gap"
    android:background="@drawable/tz_bg_tut_frame"
    android:importantForAccessibility="noHideDescendants">
    <View
      android:layout_width="match_parent"
      android:layout_height="@dimen/tz_tut_block_h"
      android:layout_marginStart="@dimen/tz_tut_inset"
      android:layout_marginTop="@dimen/tz_tut_block_top"
      android:layout_marginEnd="@dimen/tz_tut_inset"
      android:background="@drawable/tz_bg_surface3_r14" />
    <TextView
      android:id="@+id/tz_tut_number"
      style="@style/TzText.TutNumber"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tz_tut_number_start"
      android:layout_marginTop="@dimen/tz_tut_number_top"
      android:includeFontPadding="false"
      android:text="@string/tz_tut_speed" />
    <View
      android:layout_width="match_parent"
      android:layout_height="@dimen/tz_tut_pill_h"
      android:layout_gravity="bottom"
      android:layout_marginStart="@dimen/tz_tut_inset"
      android:layout_marginEnd="@dimen/tz_tut_inset"
      android:layout_marginBottom="@dimen/tz_tut_pill_bottom"
      android:background="@drawable/tz_bg_surface3_r22" />
    <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="bottom|center_horizontal"
      android:layout_marginBottom="@dimen/tz_tut_dots_bottom"
      android:orientation="horizontal">
      <View android:layout_width="@dimen/tz_tut_dot" android:layout_height="@dimen/tz_tut_dot"
        android:background="@drawable/tz_bg_text3_r3" />
      <View android:layout_width="@dimen/tz_tut_dot_active_w" android:layout_height="@dimen/tz_tut_dot"
        android:layout_marginStart="@dimen/tz_tut_dot_gap" android:background="@drawable/tz_bg_mint_r22" />
      <View android:layout_width="@dimen/tz_tut_dot" android:layout_height="@dimen/tz_tut_dot"
        android:layout_marginStart="@dimen/tz_tut_dot_gap" android:background="@drawable/tz_bg_text3_r3" />
    </LinearLayout>
  </FrameLayout>
  <ImageView
    android:id="@+id/tz_tut_arrow_right"
    android:layout_width="@dimen/tz_tut_arrow"
    android:layout_height="@dimen/tz_tut_arrow"
    android:importantForAccessibility="no"
    android:src="@drawable/ic_tz_arrow_right"
    android:tint="@color/tz_mint" />
</LinearLayout>
