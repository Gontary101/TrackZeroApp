<?xml version="1.0" encoding="utf-8"?>
<!-- X1 · Battery saver, confirm (Phase 35): what keeps working, what pauses, TURN ON. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="wrap_content"
  android:background="@drawable/tz_bg_surface1_top_r32"
  android:orientation="vertical"
  android:paddingStart="@dimen/tz_gutter"
  android:paddingTop="@dimen/tz_sheet_pad_top"
  android:paddingEnd="@dimen/tz_gutter"
  android:paddingBottom="@dimen/tz_space_24">

  <View
    android:layout_width="@dimen/tz_sheet_grabber_w"
    android:layout_height="@dimen/tz_sheet_grabber_h"
    android:layout_gravity="center_horizontal"
    android:background="@drawable/tz_bg_text3_r3" />

  <TextView
    style="@style/TzText.DotL"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/tz_space_20"
    android:paddingStart="@dimen/tz_sheet_header_pad"
    android:paddingEnd="@dimen/tz_sheet_header_pad"
    android:paddingBottom="@dimen/tz_sheet_header_pad_bottom"
    android:text="@string/tz_saver_title" />

  <TextView
    style="@style/TzText.Label"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/tz_space_4"
    android:text="@string/tz_saver_keeps" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/tz_space_4"
    android:paddingTop="@dimen/tz_saver_row_pad"
    android:paddingBottom="@dimen/tz_saver_row_pad">
    <ImageView
      android:layout_width="@dimen/tz_icon"
      android:layout_height="@dimen/tz_icon"
      android:importantForAccessibility="no"
      android:src="@drawable/ic_tz_check"
      app:tint="@color/tz_text1" />
    <TextView
      style="@style/TzText.RowTitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tz_row_gap"
      android:text="@string/tz_saver_keeps_tones"
      android:textColor="@color/tz_text1" />
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/tz_space_4"
    android:paddingTop="@dimen/tz_saver_row_pad"
    android:paddingBottom="@dimen/tz_saver_row_pad">
    <ImageView
      android:layout_width="@dimen/tz_icon"
      android:layout_height="@dimen/tz_icon"
      android:importantForAccessibility="no"
      android:src="@drawable/ic_tz_check"
      app:tint="@color/tz_text1" />
    <TextView
      style="@style/TzText.RowTitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tz_row_gap"
      android:text="@string/tz_saver_keeps_tracking"
      android:textColor="@color/tz_text1" />
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/tz_space_4"
    android:paddingTop="@dimen/tz_saver_row_pad"
    android:paddingBottom="@dimen/tz_saver_row_pad">
    <ImageView
      android:layout_width="@dimen/tz_icon"
      android:layout_height="@dimen/tz_icon"
      android:importantForAccessibility="no"
      android:src="@drawable/ic_tz_check"
      app:tint="@color/tz_text1" />
    <TextView
      style="@style/TzText.RowTitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tz_row_gap"
      android:text="@string/tz_saver_keeps_screen"
      android:textColor="@color/tz_text1" />
  </LinearLayout>
  <TextView
    style="@style/TzText.Label"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/tz_space_4"
    android:layout_marginTop="@dimen/tz_space_12"
    android:text="@string/tz_saver_paused" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/tz_space_4"
    android:paddingTop="@dimen/tz_saver_row_pad"
    android:paddingBottom="@dimen/tz_saver_row_pad">
    <ImageView
      android:layout_width="@dimen/tz_icon"
      android:layout_height="@dimen/tz_icon"
      android:importantForAccessibility="no"
      android:src="@drawable/ic_tz_minus"
      app:tint="@color/tz_text2" />
    <TextView
      style="@style/TzText.RowTitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tz_row_gap"
      android:text="@string/tz_saver_paused_map"
      android:textColor="@color/tz_text2" />
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/tz_space_4"
    android:paddingTop="@dimen/tz_saver_row_pad"
    android:paddingBottom="@dimen/tz_saver_row_pad">
    <ImageView
      android:layout_width="@dimen/tz_icon"
      android:layout_height="@dimen/tz_icon"
      android:importantForAccessibility="no"
      android:src="@drawable/ic_tz_minus"
      app:tint="@color/tz_text2" />
    <TextView
      style="@style/TzText.RowTitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tz_row_gap"
      android:text="@string/tz_saver_paused_voice"
      android:textColor="@color/tz_text2" />
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/tz_space_4"
    android:paddingTop="@dimen/tz_saver_row_pad"
    android:paddingBottom="@dimen/tz_saver_row_pad">
    <ImageView
      android:layout_width="@dimen/tz_icon"
      android:layout_height="@dimen/tz_icon"
      android:importantForAccessibility="no"
      android:src="@drawable/ic_tz_minus"
      app:tint="@color/tz_text2" />
    <TextView
      style="@style/TzText.RowTitle"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="@dimen/tz_row_gap"
      android:text="@string/tz_saver_paused_reroute"
      android:textColor="@color/tz_text2" />
  </LinearLayout>
  <com.google.android.material.button.MaterialButton
    android:id="@+id/tz_saver_turn_on"
    style="@style/TzButton.Primary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/tz_space_16"
    android:text="@string/tz_saver_turn_on"
    app:icon="@drawable/ic_tz_battery" />

  <TextView
    style="@style/TzText.Caption"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/tz_space_12"
    android:gravity="center_horizontal"
    android:text="@string/tz_saver_caption" />
</LinearLayout>
