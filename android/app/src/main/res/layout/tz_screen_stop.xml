<?xml version="1.0" encoding="utf-8"?>
<!-- S2 · Add a stop (Phase 30): over the map, the route, the place's pin and dots to it; the card with what the
     detour costs and ADD STOP. No island. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent">

  <app.trackzero.ui.TzPinLayer
    android:id="@+id/tz_stop_pins"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />

  <ImageButton
    android:id="@+id/tz_stop_back"
    style="@style/TzMapButton"
    android:layout_gravity="top|start"
    android:layout_marginStart="@dimen/tz_gutter"
    android:contentDescription="@string/tz_cd_back"
    android:src="@drawable/ic_tz_back" />

  <LinearLayout
    android:id="@+id/tz_stop_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginStart="@dimen/tz_gutter_ride"
    android:layout_marginEnd="@dimen/tz_gutter_ride"
    android:background="@drawable/tz_bg_surface2_r32"
    android:clickable="true"
    android:elevation="@dimen/tz_elev2"
    android:orientation="vertical"
    android:paddingStart="@dimen/tz_preview_card_pad"
    android:paddingTop="@dimen/tz_space_12"
    android:paddingEnd="@dimen/tz_preview_card_pad"
    android:paddingBottom="@dimen/tz_preview_card_pad">
    <View
      android:layout_width="@dimen/tz_grabber_w"
      android:layout_height="@dimen/tz_grabber_h"
      android:layout_gravity="center_horizontal"
      android:background="@drawable/tz_bg_grabber_r2" />
    <TextView
      android:id="@+id/tz_stop_label"
      style="@style/TzText.Label"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/tz_space_16"
      android:maxLines="1" />
    <TextView
      android:id="@+id/tz_stop_name"
      style="@style/TzText.PreviewTitle"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/tz_space_4"
      android:ellipsize="end"
      android:maxLines="2" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/tz_space_16"
      android:orientation="horizontal">
      <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
          android:id="@+id/tz_stop_ahead_label"
          style="@style/TzText.Label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/tz_stop_ahead" />
        <app.trackzero.ui.TzMetricView
          android:id="@+id/tz_stop_ahead"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/tz_label_gap"
          app:tzNumberSize="36"
          app:tzNumberStyle="@style/TzText.MetricM" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/tz_stop_detour_cell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
          style="@style/TzText.Label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/tz_stop_detour" />
        <app.trackzero.ui.TzMetricView
          android:id="@+id/tz_stop_detour"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/tz_label_gap"
          app:tzNumberSize="36"
          app:tzNumberStyle="@style/TzText.MetricM" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/tz_stop_time_cell"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
          style="@style/TzText.Label"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/tz_stop_extra_time" />
        <app.trackzero.ui.TzMetricView
          android:id="@+id/tz_stop_time"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="@dimen/tz_label_gap"
          app:tzNumberSize="36"
          app:tzNumberStyle="@style/TzText.MetricM" />
      </LinearLayout>
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
      android:id="@+id/tz_stop_add"
      style="@style/TzButton.Primary"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/tz_space_20"
      android:text="@string/tz_stop_add"
      app:icon="@drawable/ic_tz_plus" />
    <TextView
      android:id="@+id/tz_stop_note"
      style="@style/TzText.Caption"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/tz_space_12"
      android:gravity="center_horizontal"
      android:text="@string/tz_stop_note" />
  </LinearLayout>
</FrameLayout>
