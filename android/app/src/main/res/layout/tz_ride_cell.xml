<?xml version="1.0" encoding="utf-8"?>
<!-- One R4 grid cell: label over a large metric. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="0dp"
  android:layout_height="match_parent"
  android:layout_weight="1"
  android:gravity="center_vertical"
  android:orientation="vertical"
  android:paddingStart="@dimen/tz_ride_cell_pad_h"
  android:paddingTop="@dimen/tz_ride_cell_pad_v"
  android:paddingEnd="@dimen/tz_ride_cell_pad_h"
  android:paddingBottom="@dimen/tz_ride_cell_pad_v">

  <TextView
    android:id="@+id/tz_cell_label"
    style="@style/TzText.Label"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" />

  <app.trackzero.ui.TzMetricView
    android:id="@+id/tz_cell_value"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/tz_ride_cell_gap"
    app:tzNumberSize="50"
    app:tzNumberStyle="@style/TzText.MetricL" />
</LinearLayout>
