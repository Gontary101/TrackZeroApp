<?xml version="1.0" encoding="utf-8"?>
<!-- R5 page 2: the current / next climb of the route, or the elevation ridden (free ride, no elevation). Opaque. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/tz_bg">

  <LinearLayout
    android:id="@+id/tz_ride_climb_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/tz_gutter"
    android:paddingEnd="@dimen/tz_gutter">

    <LinearLayout
      android:id="@+id/tz_ride_climb_header"
      android:layout_width="match_parent"
      android:layout_height="@dimen/tz_ride_header_h"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="@dimen/tz_space_4"
      android:paddingEnd="@dimen/tz_space_4">

      <ImageView
        android:id="@+id/tz_ride_climb_icon"
        android:layout_width="@dimen/tz_climb_icon"
        android:layout_height="@dimen/tz_climb_icon"
        android:layout_marginEnd="@dimen/tz_space_12"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_tz_mountain"
        app:tint="@color/tz_text1" />

      <TextView
        android:id="@+id/tz_ride_climb_title"
        style="@style/TzText.ClimbTitle"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:layout_weight="1"
        android:maxLines="1"
        app:autoSizeMaxTextSize="@dimen/tz_text_26"
        app:autoSizeMinTextSize="@dimen/tz_text_16"
        app:autoSizeTextType="uniform" />

      <TextView
        android:id="@+id/tz_ride_climb_pill"
        style="@style/TzText.ClimbPill"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/tz_climb_pill_h"
        android:layout_marginStart="@dimen/tz_space_12"
        android:background="@drawable/tz_bg_surface3_r14"
        android:gravity="center"
        android:paddingStart="@dimen/tz_space_12"
        android:paddingEnd="@dimen/tz_space_12" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/tz_ride_climb_metrics"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/tz_space_20"
      android:orientation="horizontal"
      android:paddingStart="@dimen/tz_space_4"
      android:paddingEnd="@dimen/tz_space_4">

      <include
        android:id="@+id/tz_ride_climb_grade"
        layout="@layout/tz_ride_climb_metric" />

      <include
        android:id="@+id/tz_ride_climb_to_summit"
        layout="@layout/tz_ride_climb_metric" />

      <include
        android:id="@+id/tz_ride_climb_gained"
        layout="@layout/tz_ride_climb_metric" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/tz_ride_climb_card"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/tz_space_20"
      android:background="@drawable/tz_bg_surface1_r28"
      android:elevation="@dimen/tz_elev1"
      android:orientation="vertical"
      android:padding="@dimen/tz_space_16">

      <app.trackzero.ui.TzSegmented
        android:id="@+id/tz_ride_climb_range"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/tz_climb_card_gap" />

      <app.trackzero.ui.TzElevationProfileView
        android:id="@+id/tz_ride_profile"
        android:layout_width="match_parent"
        android:layout_height="@dimen/tz_climb_profile_h" />
    </LinearLayout>
  </LinearLayout>

  <app.trackzero.ui.TzStatsIsland
    android:id="@+id/tz_ride_climb_stats"
    android:layout_width="match_parent"
    android:layout_height="@dimen/tz_stats_island_h"
    android:layout_gravity="bottom"
    android:layout_marginStart="@dimen/tz_gutter_ride"
    android:layout_marginEnd="@dimen/tz_gutter_ride" />
</FrameLayout>
