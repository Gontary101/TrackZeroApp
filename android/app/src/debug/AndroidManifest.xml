<manifest
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">
  <application
    android:gwpAsanMode="always"
    android:memtagMode="sync"
    tools:replace="android:memtagMode">
    <!-- TrackZero component gallery: adb shell am start -n app.trackzero.debug/app.trackzero.TzGalleryActivity -->
    <activity
      android:name="app.trackzero.TzGalleryActivity"
      android:exported="true"
      android:screenOrientation="portrait"
      android:theme="@style/TzGalleryTheme" />
    <!-- Ride controls until the ride screens exist: adb shell am start -n app.trackzero.debug/app.trackzero.TzRideDebugActivity -->
    <activity
      android:name="app.trackzero.TzRideDebugActivity"
      android:exported="true"
      android:screenOrientation="portrait"
      android:theme="@style/TzGalleryTheme" />
  </application>
</manifest>
